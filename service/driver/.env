# ==============================
# Driver Service Configuration
# ==============================

# App server port inside the container
APP_PORT=8080

# Redis connection (from infra.compose.yml)
REDIS_ADDR=redis://redis:6379


# ==============================
# Networking & Environment
# ==============================

# Service URLs (used if TripService or MCP connects to this one)
# Replace <private-ip> with the actual EC2 internal IPs if needed
USER_SVC_URL=http://localhost:8081
TRIP_SVC_URL=http://localhost:8083

# ==============================
# Observability
# ==============================

# Optional tracing endpoint (if Jaeger or OTEL collector is running)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# ==============================
# Logging
# ==============================

LOG_LEVEL=info
APP_ENV=prod

# ==============================
# Security (if you later add JWT auth)
# ==============================
# JWT_SECRET=supersecretkey123
# JWT_ISSUER=driver-svc
